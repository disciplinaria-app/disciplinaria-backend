# Copia este archivo como .env y completa los valores.
# En Railway, defínelos como variables del servicio: nunca subas el .env.

# --- Modelo -----------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional. Modelo del agente de triage. Si se omite, emplea el mismo de los
# cinco agentes de análisis.
# MODEL_TRIAGE=anthropic/claude-sonnet-4-5


# --- Ingesta por reenvío (worker: python -m ingesta.worker) -----------------
# Buzón PROPIO del sistema al que una regla de Outlook reenvía la
# correspondencia. No es el buzón institucional ni requiere sus credenciales.
# Para Gmail: IMAP_SERVIDOR=imap.gmail.com y una contraseña de aplicación
# (exige verificación en dos pasos activa en la cuenta).
IMAP_SERVIDOR=imap.gmail.com
IMAP_PUERTO=993
IMAP_USUARIO=triage.correspondencia@gmail.com
IMAP_CLAVE=xxxx xxxx xxxx xxxx
IMAP_CARPETA=INBOX
IMAP_SSL=true

# Servidor por el que se remiten las fichas.
SMTP_SERVIDOR=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=triage.correspondencia@gmail.com
SMTP_CLAVE=xxxx xxxx xxxx xxxx
SMTP_STARTTLS=true
# Si se omite, se usa SMTP_USUARIO.
# SMTP_REMITENTE=triage.correspondencia@gmail.com

# Buzón al que llegan las fichas. Si se omite, se usa IMAP_USUARIO.
DESTINATARIO_FICHAS=tu.correo@cendoj.ramajudicial.gov.co

# Buzones propios, separados por comas. Un correo que provenga de alguno de
# ellos se presume reenviado, y el worker recupera el remitente original
# sepultado en el mensaje. Sin esto, el cotejo compararía la entidad
# interpelada contra tu propio despacho.
DIRECCIONES_PROPIAS=tu.correo@cendoj.ramajudicial.gov.co

# --- Ajustes del ciclo (opcionales) ----------------------------------------
# INTERVALO_SONDEO=300
# MAX_CORREOS_POR_CICLO=20
# MAX_INTENTOS_POR_CORREO=3
# ESTADO_INGESTA=estado_ingesta.json
