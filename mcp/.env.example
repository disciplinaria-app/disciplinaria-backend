# Llave que Claude debe enviar en Authorization: Bearer <llave>. Genérela con: python -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_API_KEY=
# Directorio del corpus local (en Cloud Run solo /tmp es escribible).
CORPUS_DIR=/tmp/redactar2-corpus
CORPUS_DIAS_CACHE=30
# Contacto que viaja en el User-Agent hacia los portales oficiales.
MCP_CONTACTO=
# Desactivar navegador (0) solo para pruebas sin Chromium.
PLAYWRIGHT_HABILITADO=1
